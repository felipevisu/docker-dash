{
  "name": "docker-dash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Terminal dashboard for Docker (Colima) and Podman, built with Gridland",
  "bin": {
    "docker-dash": "src/cli.tsx"
  },
  "scripts": {
    "start": "bun run src/cli.tsx",
    "mock": "bun run src/cli.tsx --mock",
    "compile": "bun build --compile --minify src/cli.tsx --outfile build/docker-dash",
    "preview": "vite",
    "install-cli": "./install.sh",
    "uninstall-cli": "./uninstall.sh"
  },
  "dependencies": {
    "@gridland/bun": "^0.4.3",
    "@gridland/utils": "^0.4.3",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@gridland/web": "^0.4.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
